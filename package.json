{
  "name": "api-quality-spectral-ruleset",
  "version": "1.4.1-beta.5",
  "description": "Spectral ruleset by API Quality",
  "main": "apq-spectral.yaml",
  "files": [
    "apq-spectral.yaml",
    "functions/"
  ],
  "scripts": {
    "test": "jest --coverage --detectOpenHandles --no-cache --forceExit",
    "make-badges": "coverage-badges"
  },
  "keywords": [
    "spectral",
    "linter",
    "openapi"
  ],
  "author": {
    "name": "APIQuality"
  },
  "license": "GNU AGPLv3",
  "repository": {
    "type": "git",
    "url": "https://github.com/apiaddicts/apquality-spectral"
  },
  "devDependencies": {
    "@stoplight/spectral-core": "1.23.0",
    "@stoplight/spectral-functions": "^1.10.5",
    "@stoplight/spectral-ruleset-migrator": "^1.12.1",
    "@stoplight/spectral-rulesets": "1.22.2",
    "@types/jest": "^29.5.14",
    "coverage-badges-cli": "^2.1.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "functions/*.js"
    ],
    "coverageThreshold": {
      "./functions/*.js": {
        "statements": 0
      }
    },
    "coverageReporters": [
      "lcov",
      "json-summary"
    ]
  }
}
